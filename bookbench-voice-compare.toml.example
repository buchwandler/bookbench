# Five candidates. Each profile is generated/validated by VoiceRender.
source = "fixtures/smoke.md"
language = "en-US"
title = "BookBench Five Voice Comparison"
work_root = ".bookbench/runs"
cache_dir = ".bookbench/cache/voicerender"
chapters = "all"
max_replans = 3
fail_fast = false

[speechscope]
backend = "redux"
device = "cpu"
normalization = "basic-v1"
reference_mode = "renderplan"
max_wer = 0.10
max_cer = 0.05

[[voices]]
name = "piper-amy"
profile = "profiles/piper.renderprofile.toml"

# Create these four RenderProfiles first with `voicerender profile create`.
[[voices]]
name = "kokoro-a"
profile = "profiles/kokoro-a.renderprofile.toml"

[[voices]]
name = "kokoro-b"
profile = "profiles/kokoro-b.renderprofile.toml"

[[voices]]
name = "kitten-a"
profile = "profiles/kitten-a.renderprofile.toml"

[[voices]]
name = "supertonic-a"
profile = "profiles/supertonic-a.renderprofile.toml"
