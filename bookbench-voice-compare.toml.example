# Three candidates using RenderProfiles included in this repository.
source = "fixtures/smoke.md"
language = "en-US"
title = "BookBench Three Engine Comparison"
work_root = ".bookbench/runs"
cache_dir = ".bookbench/cache/voicerender"
chapters = "all"
max_replans = 3
fail_fast = false

[speechscope]
backend = "redux"
device = "cpu"
normalization = "basic-v1"
reference_mode = "renderplan"
max_compound_wer = 0.10
max_cer = 0.05

[[voices]]
name = "piper-amy"
profile = "profiles/piper.renderprofile.toml"

[[voices]]
name = "kitten-bella"
profile = "profiles/kitten.renderprofile.toml"

[[voices]]
name = "kokoro-heart"
profile = "profiles/kokoro.renderprofile.toml"
