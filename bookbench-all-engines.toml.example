source = "fixtures/smoke.md"
language = "en-US"
title = "BookBench All Engines"
profiles_dir = "profiles"
work_root = ".bookbench/runs"
cache_dir = ".bookbench/cache/voicerender"
chapters = "all"
max_replans = 3
fail_fast = false
required_engines = ["kokoro", "piper", "pocket", "kitten", "sopro", "supertonic", "inflect"]

[speechscope]
backend = "redux"
device = "cpu"
normalization = "basic-v1"
# Default exact spoken-content gate with bounded compound-boundary tolerance.
max_compound_wer = 0.0
# Optional strict token-boundary gate:
# max_wer = 0.0
max_cer = 0.0
reference_mode = "renderplan"
